{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured interactions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source", "trigger", "action", "destination"],
    "properties": {
      "source": {"type": "string", "minLength": 1},
      "trigger": {"type": "string"},
      "action": {"type": "string"},
      "destination": {"type": "string"}
    }
  }
}
